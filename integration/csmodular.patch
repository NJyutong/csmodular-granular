@@ -0,0 +1,81 @@
+import { localize } from '../utils/locale.js';
+const t = (en, zh, ru) => localize({ en, zh, ru });
+
+// One reusable guide for the whole application and each granular module.
+export function installGranularGuide(system) {
+    if (document.getElementById('granular-guide-open')) return;
+    const style = document.createElement('style');
+    style.textContent = `
+      #granular-guide-open { position:fixed;right:16px;top:12px;z-index:9000;padding:9px 14px;background:#253847;color:#fff;border:1px solid #708b9f;border-radius:4px;cursor:pointer;font:inherit; }
+      #granular-guide { box-sizing:border-box;margin:auto;width:min(680px,calc(100vw - 32px));max-height:85vh;overflow:auto;padding:24px;background:#25292d;color:#f2f4f6;border:1px solid #71818d;border-radius:6px;font:15px/1.65 system-ui,sans-serif; }
+      #granular-guide::backdrop {background:rgba(0,0,0,.65)}
+      #granular-guide h2 {margin:0 0 16px;font-size:24px} #granular-guide h3 {margin:22px 0 8px;font-size:18px}
+      #granular-guide ol {padding-left:24px} #granular-guide p {margin:8px 0} #granular-guide li {margin:8px 0} #granular-guide summary {cursor:pointer;font-weight:600;padding:10px 0}
+      #granular-guide button {padding:9px 14px;background:#344b5e;color:#fff;border:1px solid #8298a9;border-radius:4px;font:inherit;cursor:pointer}
+      #granular-guide button:focus-visible,#granular-guide summary:focus-visible,#granular-guide-open:focus-visible {outline:3px solid #a9d9ff;outline-offset:3px}
+      #granular-guide .guide-actions {display:flex;gap:12px;flex-wrap:wrap;margin:18px 0}
+      #granular-guide [role=status] {color:#ffe0a3}
+    `;
+    document.head.append(style);
+    const open = document.createElement('button');
+    open.id = 'granular-guide-open';
+    open.textContent = t('Start here', '入门指南', 'Начать здесь');
+    open.onclick = () => showGranularGuide(system);
+    document.body.append(open);
+}
+
+export function showGranularGuide(system, moduleName = '') {
+    document.getElementById('granular-guide')?.remove();
+    const dialog = document.createElement('dialog');
+    dialog.id = 'granular-guide';
+    dialog.setAttribute('aria-labelledby','granular-guide-title');
+    const add = (tag, text, parent = dialog) => { const el=document.createElement(tag);el.textContent=text;parent.append(el);return el; };
+    add('h2', t('Your first sound', '从零开始，让它发声', 'Ваш первый звук')).id='granular-guide-title';
+    add('p', t('A patch is a set of modules connected by cables. A source makes sound; Outs2 sends it to your speakers.', '一个“音色工程”由模块和连线组成。声源模块产生声音，Outs2 输出模块把声音送到扬声器。只有声源，没有连接到 Outs2，也听不到声音。', 'Патч — это модули, соединённые кабелями. Источник создаёт звук, а Outs2 выводит его на динамики.'));
+    const steps=add('ol','');
+    for(const text of [
+        t('Load the starter below. It connects Grain Osc → Outs2; no WAV or microphone is needed.', '点击下方“加载发声示例”。它已经连好“颗粒振荡器 → Outs2”，不需要 WAV 文件或麦克风。', 'Загрузите пример ниже: Grain Osc → Outs2. Файл WAV и микрофон не нужны.'),
+        t('Lower your speaker volume, then press ▶ in the bottom bar. Press ■ to stop.', '先调低扬声器音量，再点击底栏的 ▶ 开始播放；点击 ■ 停止。', 'Уменьшите громкость динамиков и нажмите ▶ на нижней панели. Кнопка ■ останавливает звук.'),
+        t('Drag Pitch up/down to hear the note change. Then try Grain Size and Density, one at a time.', '按住“音高”旋钮上下拖动，听音高变化。再分别试“粒长”和“颗粒/秒”，一次只改一个参数。', 'Перетаскивайте регулятор высоты вверх/вниз. Затем попробуйте длительность и плотность гранул по одному.')
+    ])add('li',text,steps);
+    const actions=add('div','');actions.className='guide-actions';
+    const load=add('button',t('Load starter patch','加载发声示例','Загрузить пример'),actions);
+    const close=add('button',t('Close guide','关闭指南','Закрыть'),actions);close.onclick=()=>dialog.close();
+    const status=add('p','');status.setAttribute('role','status');
+    load.onclick=async()=>{
+        if(system.locked){status.textContent=t('Unlock the patch first using the lock control in the bottom bar.','请先通过底栏的锁定按钮解锁工程。','Сначала разблокируйте патч кнопкой замка на нижней панели.');return;}
+        if(system.components?.length && !confirm(t('Replace the current patch? Save your work first.','示例会替换当前工程。请先保存现有工程，是否继续？','Заменить текущий патч? Сначала сохраните свою работу.')))return;
+        load.disabled=true;
+        try{
+            await system.csoundEngine?.stop();
+            const response=await fetch('/patches/granular-demo.json');if(!response.ok)throw Error('demo');
+            const patch=await response.json();
