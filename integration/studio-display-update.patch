+.pulvis-about-dialog {
+  position: fixed;
+  inset: 0;
+  margin: auto;
+  width: min(26rem, calc(100vw - 2rem));
+  max-height: calc(100dvh - 2rem);
+  overflow: auto;
+  box-sizing: border-box;
+  padding: 24px;
+  border: 1px solid #526861;
+  border-radius: 12px;
+  background: #192321;
+  color: #f1f6f3;
+  font: 14px/1.45 system-ui, sans-serif;
+  box-shadow: 0 12px 40px #0006;
+  color-scheme: dark;
+}
+.pulvis-about-dialog::backdrop { background: rgb(10 16 16 / 58%); }
+.pulvis-about-dialog img { float: right; border-radius: 8px; }
+.pulvis-about-dialog h2 { margin: 0; font-size: 21px; }
+.pulvis-about-dialog p { margin: 3px 0 16px; color: #bdcbc5; }
+.pulvis-about-dialog dl { clear: both; border-block: 1px solid #42534d; padding: 14px 0; margin: 0 0 14px; }
+.pulvis-about-dialog dt { color: #bdcbc5; font-size: 12px; }
+.pulvis-about-dialog dd { margin: 2px 0 12px; overflow-wrap: anywhere; }
+.pulvis-about-dialog dd:last-child { margin-bottom: 0; }
+.pulvis-about-dialog a { color: #b0e8d4; }
+.pulvis-about-dialog small { display: block; color: #bdcbc5; white-space: pre-line; }
+.pulvis-about-dialog button { display: block; margin: 16px 0 0 auto; border: 0; border-radius: 6px; padding: 6px 16px; color: #12241e; background: #b0dbc7; font: inherit; cursor: pointer; }
