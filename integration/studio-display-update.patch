+// Display the magnitude bins produced by Csound on a logarithmic frequency axis.
+function drawSpectrum(ctx, bins, x, y, width, height, palette, label) {
+    const minHz = 40, maxHz = 20000, nyquist = 24000;
+    const xAt = hz => x + Math.log(hz / minHz) / Math.log(maxHz / minHz) * width;
+    const floorY = y + height - 8;
+    ctx.save();
+    ctx.font = '8px ' + MONO_FONT;
+    ctx.textAlign = 'left';
+    ctx.textBaseline = 'bottom';
+    ctx.fillStyle = palette.mutedText;
+    ctx.fillText(label, x, y + 7);
+    for (const [hz, tick] of [[100, '100'], [1000, '1k'], [10000, '10k']]) {
+        const tx = xAt(hz);
+        ctx.strokeStyle = palette.oledGrid;
+        ctx.beginPath();
+        ctx.moveTo(tx, y + 8);
+        ctx.lineTo(tx, floorY);
+        ctx.stroke();
+        ctx.textAlign = 'center';
+        ctx.fillText(tick, tx, y + height + 1);
+    }
+    if (bins?.length > 1) {
+        const count = 36;
+        const binHz = nyquist / (bins.length - 1);
+        ctx.fillStyle = palette.accent;
+        for (let i = 0; i < count; i++) {
+            const first = Math.max(1, Math.round(minHz * (maxHz / minHz) ** (i / count) / binHz));
+            const end = Math.max(first + 1, Math.round(minHz * (maxHz / minHz) ** ((i + 1) / count) / binHz));
+            let peak = 0;
+            for (let bin = first; bin < end; bin++) peak = Math.max(peak, bins[bin]);
+            const level = Math.max(0, Math.min(1, (20 * Math.log10(peak) + 72) / 72));
+            const barHeight = level * (floorY - y - 7);
+            ctx.fillRect(x + i * width / count, floorY - barHeight, width / count - 1, barHeight);
+        }
+    }
+    ctx.restore();
+}
